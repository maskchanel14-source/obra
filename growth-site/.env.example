# Optional: public Supabase values used for catalog reads and opt-in page-path logging.
# They are included in the browser bundle only when BOTH are configured.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-side only. Required by `npm run sync:supabase`; never bundle or commit this value.
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional public contact shown on /contact. Configure a monitored address before launch.
# STORE_SUPPORT_EMAIL=support@your-real-domain.com

# Optional site metadata overrides for production builds.
# SITE_URL=https://your-real-domain.example
# STORE_NAME=Obra Market
